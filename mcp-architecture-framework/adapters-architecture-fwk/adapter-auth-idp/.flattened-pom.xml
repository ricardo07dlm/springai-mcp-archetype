  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.ricardodlm.springai.mcp.adapters</groupId>
    <artifactId>adapters-architecture-fwk</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>adapter-auth-idp</artifactId>
  <version>1.0.0</version>
  <name>Adapter Auth Idp — RedHat SSO</name>
  <description>Librería de validación JWT pura — sin Spring Security, sin filtros HTTP.
        Responsabilidades:
        - Descargar y cachear JWKS de RedHat SSO (JwksRemoteLoader, JwksKeyResolver)
        - Validar firma, expiración, issuer y audience del JWT (TokenValidator)
        - Modelos propios: Jwt, Role, Scope, Authority, JwtClaims
        No depende de transport-auth-service ni de ningún módulo de transport.</description>
