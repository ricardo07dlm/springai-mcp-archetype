    <artifactId>transport-architecture-fwk</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>transport-streamable-mvc</artifactId>
  <version>1.0.0</version>
  <name>Transport Streamable MVC</name>
  <description>Librería de transporte Streamable para servidores MCP.
